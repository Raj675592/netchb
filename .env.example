# Local MongoDB example. Replace with your MongoDB Atlas connection string if needed.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=sefer_entry_workbench
# Optional comma-separated list if you intentionally host the frontend elsewhere.
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional. Only used when the user explicitly checks “Use optional AI extraction”.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
